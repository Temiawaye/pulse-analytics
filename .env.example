# Public base URL used to build installation links and canonical URLs.
APP_URL=http://localhost:3000

# Pooled PostgreSQL URL used by the application at runtime.
DATABASE_URL=postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true

# Direct or session-mode PostgreSQL URL used by Prisma CLI migrations.
DIRECT_URL=postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres
